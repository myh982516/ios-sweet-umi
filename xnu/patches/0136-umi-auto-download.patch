+/*
+ * Automatic download mode. Called from a kernel thread (never from the console
+ * path): the SMC call below resets the SoC, so everything it prints is flushed
+ * to the persistent log first and read back over firehose after the reset.
+ *
+ * The calls tried below are, in order: the SMCCC packing Linux uses
+ * (fast call, SIP owner, svc 1 cmd 0x10 = set download mode, args
+ * (0x10, enable)), and the older packing x0 = (svc << 8) | cmd with
+ * x1 = (nargs << 24) | 1. The argument shape moved between generations, so
+ * try the candidates and print every return value.
+ */
+static void
+sweet_smc(uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3, uint64_t ret[4])
+{
+	register uint64_t x0 __asm__("x0") = a0;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+
+	__asm__ volatile("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+	    :
+	    : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	      "x14", "x15", "x16", "x17", "cc", "memory");
+	ret[0] = x0;
+	ret[1] = x1;
+	ret[2] = x2;
+	ret[3] = x3;
+}
+
+#define SWEET_MISC_BLOCK        1024u           /* 0x400000 / 4 KiB */
+#define SWEET_PS_SYSTEM_RESET   0x84000009ull
+
+/*
+ * Put an AOSP bootloader_message command into "misc": ABL reads it before it
+ * picks a boot target, which turns the next reset into fastboot without a key
+ * press. Written only if the field differs, and read back into the log.
+ */
+static void
+sweet_misc_command(const char *cmd)
+{
+	uint8_t *buf = (uint8_t *)(su.dma + DMA_BOUNCE);
+	int error;
+
+	if (!su.writable) {
+		printf("SWEET EDL: misc not writable, skipped\n");
+		return;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_read_raw(SWEET_MISC_BLOCK, 1);
+	if (error) {
+		printf("SWEET EDL: misc read -> %d\n", error);
+	} else {
+		printf("SWEET EDL: misc said '%.32s'\n", (const char *)buf);
+		if (memcmp(buf, cmd, strlen(cmd) + 1) != 0) {
+			bzero(buf, 32);
+			strlcpy((char *)buf, cmd, 32);
+			error = ufs_write_raw(SWEET_MISC_BLOCK, 1);
+			if (!error) {
+				error = ufs_sync_cache();
+			}
+			printf("SWEET EDL: misc <- '%s' -> %d\n", cmd, error);
+		} else {
+			printf("SWEET EDL: misc already set\n");
+		}
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+}
+
+static void
+sweet_auto_download(void)
+{
+	static const struct {
+		const char *name;
+		uint64_t x0, x1, x2, x3;
+	} tries[] = {
+		/* Modern SMCCC packing (Linux qcom_scm): fast call, SIP owner,
+		 * svc 1 cmd 0x10 = set download mode, args (0x10, enable). */
+		{ "smccc64 dload 10,10", 0xc2000110ull, 2, 0x10, 0x10 },
+		{ "smccc32 dload 10,10", 0x82000110ull, 2, 0x10, 0x10 },
+		{ "smccc64 dload 1,1", 0xc2000110ull, 2, 1, 1 },
+		{ "smccc32 dload 1,1", 0x82000110ull, 2, 1, 1 },
+		/* Legacy packing: x0 = (svc << 8) | cmd, x1 = (nargs << 24) | 1. */
+		{ "legacy svc1/cmd2", 0x102ull, 0x02000001ull, 1, 0 },
+		{ "legacy svc2/cmd3", 0x203ull, 0x02000001ull, 1, 0 },
+	};
+	uint64_t r[4];
+	int accepted = 0;
+
+	printf("SWEET EDL: %u good flushes, asking SCM for download mode\n",
+	    (unsigned)os_atomic_load(&sweet_edl_flushes, relaxed));
+	for (size_t i = 0; i < sizeof(tries) / sizeof(tries[0]); i++) {
+		sweet_smc(tries[i].x0, tries[i].x1, tries[i].x2, tries[i].x3, r);
+		printf("SWEET EDL: SCM %s x0 0x%llx -> %llx %llx %llx %llx\n",
+		    tries[i].name, (unsigned long long)tries[i].x0,
+		    (unsigned long long)r[0], (unsigned long long)r[1],
+		    (unsigned long long)r[2], (unsigned long long)r[3]);
+		/* SMCCC success is exactly 0; error codes are 32-bit values that
+		 * may or may not be sign extended, so do not test the sign. */
+		if (r[0] == 0) {
+			accepted = 1;
+		}
+	}
+	if (!accepted) {
+		printf("SWEET EDL: SCM rejected all, using misc\n");
+		sweet_misc_command("boot-fastboot");
+	} else {
+		printf("SWEET EDL: SCM accepted a request\n");
+	}
+	/* The reset takes the console with it: persist these lines first. */
+	sweet_log_flush_to_disk();
+	printf("SWEET EDL: PSCI SYSTEM_RESET\n");
+	sweet_log_flush_to_disk();
+	sweet_smc(SWEET_PS_SYSTEM_RESET, 0, 0, 0, r);
+	printf("SWEET EDL: reset returned 0x%llx\n", (unsigned long long)r[0]);
+}
+
+/* One shot, woken by the console path's flush counter. */
+static void
+sweet_edl_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		/* Check before sleeping: a wakeup sent before the first sleep is not
+		 * queued, and the flush counter is already past the mark by then. */
+		if (sweet_edl_after != 0 &&
+		    os_atomic_load(&sweet_edl_flushes, relaxed) >= sweet_edl_after) {
+			sweet_edl_after = 0;	/* one shot */
+			sweet_auto_download();
+			continue;
+		}
+		(void)tsleep(&sweet_edl_chan, PZERO, "sweetedl", 0);
+	}
+}
