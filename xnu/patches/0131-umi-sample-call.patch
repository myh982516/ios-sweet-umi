--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -996,8 +996,28 @@
 		 * shows how many periods the kernel has survived. */
 		printf("SWEET TICK %llu\n", (unsigned long long)mach_absolute_time());
 		sweet_log_flush_to_disk();
 		/*
+		 * Every fifth pass, once userspace has had time to come up, dump the
+		 * user stacks of the processes named by sweetsample: that is how we see
+		 * where backboardd blocks before it starts the window server.
+		 */
+		{
+			static int rounds;
+			static uint64_t t0;
+			uint64_t elapsed = 0;
+
+			if (t0 == 0) {
+				t0 = mach_absolute_time();
+			}
+			absolutetime_to_nanoseconds(mach_absolute_time() - t0, &elapsed);
+			if (elapsed > 60ULL * NSEC_PER_SEC && (rounds % 5) == 0) {
+				extern void sweet_sample_now(void);
+				sweet_sample_now();
+			}
+			rounds++;
+		}
+		/*
 		 * Absolute deadline: hz is not initialised when this thread starts, so a
 		 * tick based tsleep can sleep forever (it did).
 		 */
 		uint64_t deadline;
