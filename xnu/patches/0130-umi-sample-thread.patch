+/* Sampling thread: driven by an absolute deadline, which does work in this
+ * port (the tick based sleeps never expire). Samples first and sleeps after,
+ * so a dump lands even if the wait never returns. Started from the first exec
+ * (kern_exec.c): before that there is no userspace to sample. */
+static int sweet_sample_chan;
+
+static void
+sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (int i = 0; i < 20; i++) {
+		printf("SWEET SMP: sample round %d\n", i);
+		{
+			extern void sweet_sample_now(void);
+			sweet_sample_now();
+		}
+		uint64_t deadline;
+		clock_interval_to_deadline(15, NSEC_PER_SEC, &deadline);
+		assert_wait_deadline(&sweet_sample_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+void
+sweet_sample_kick(void)
+{
+	static int started;
+	thread_t thread;
+
+	if (started) {
+		return;
+	}
+	started = 1;
+	if (kernel_thread_start(sweet_sample_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
