+/*
+ * Nine clocks with the data line let go, which is how a slave that is waiting
+ * for the rest of a byte is told to forget it.
+ *
+ * i2c_bus_recover() above does this only when a line reads low, and it returns
+ * at once when both read high -- which, with ldoc1 on, they always do. So the
+ * one clear that costs nothing has never been sent on this boot path, and a
+ * slave left half way through a byte by the previous run (fastboot boot does
+ * not power-cycle the SoC) keeps every bit of that state across resets. Reset
+ * resets the receiving core, not the shift register that is holding SDA down.
+ * umi_touch_clear=N sends N of them unconditionally, before the reset.
+ */
+static void
+i2c_clock_clear(unsigned pulses)
+{
+	line_release(pin_sda);
+	for (unsigned i = 0; i < pulses; i++) {
+		line_low(pin_scl);
+		i2c_delay();
+		line_release(pin_scl);
+		i2c_delay();
+	}
+	i2c_stop();
+}
+
+/* Every transfer starts by forgetting what the last one's acknowledge bits were. */
+static void
+i2c_ack_reset(void)
+{
+	ack_bits = 0;
+	ack_writes = 0;
+	ack_read = false;
+	ack_read_tried = false;
+	nak_write = 0;
+}
+
+/*
+ * The read address, on its own: the one byte in a register read that says
+ * whether anything is at that address at all. The three bytes before it are
+ * acknowledged by any slave that recognised the address, whatever they mean,
+ * so only this one and the first one carry information about presence.
+ */
+static bool
+i2c_write_read_address(void)
+{
+	ack_read_tried = true;
+	ack_read = i2c_write_byte((uint8_t)(I2C_ADDRESS << 1 | 1));
+	return ack_read;
+}
+
+#define ACK_MASK_MAX 10
+
+/* "AAAA" -- one character per write byte, in the order they went out. */
+static void
+ack_string(char *out, size_t size)
+{
+	unsigned i, n = 0;
+
+	for (i = 0; i < ack_writes && i < 8 && n + 1 < size; i++) {
+		out[n++] = (ack_bits >> i) & 1 ? 'A' : '.';
+	}
+	if (n == 0 && n + 1 < size) {
+		out[n++] = '-';
+	}
+	out[n] = '\0';
+}
+
+/*
+ * One register read, said as two separate facts: which bytes were
+ * acknowledged, and what came back. A read that was not acknowledged has no
+ * data at all -- the buffer is untouched -- so printing the zeros it was
+ * initialised to is what made "the chip is not there" and "the chip answers
+ * zero" the same line in the log.
+ */
+static void
+report_read(const char *what, uint16_t address, const uint8_t *data, bool ok)
+{
+	char mask[ACK_MASK_MAX];
+
+	ack_string(mask, sizeof(mask));
+	if (!ok) {
+		printf("UMI TOUCH: %s %#06x: ack %s, read %s (first NAK: byte %u), no data\n",
+		    what, address, mask, ack_read_tried ? "NAKed" : "not reached", nak_write);
+		return;
+	}
+	printf("UMI TOUCH: %s %#06x: ack %s, read acked, data %02x %02x\n",
+	    what, address, mask, data[0], data[1]);
+}
+
+/* Ask every 7-bit address on the bus who is there. Nothing is written anywhere. */
+static unsigned
+i2c_scan(void)
+{
+	unsigned found = 0;
+
+	printf("UMI TOUCH: scanning 0x08..0x77 for an acknowledge\n");
+	for (unsigned a = 0x08; a <= 0x77; a++) {
+		i2c_ack_reset();
+		i2c_start();
+		if (i2c_write_byte((uint8_t)(a << 1))) {
+			printf("UMI TOUCH:   %#04x acknowledges\n", a);
+			found++;
+		}
+		i2c_stop();
+	}
+	printf("UMI TOUCH: %u of 112 addresses acknowledge\n", found);
+	if (found > 8) {
+		printf("UMI TOUCH: that is not a bus of peripherals: every byte is reading "
+		    "back as an acknowledge, so no acknowledge on it means anything\n");
+	}
+	return found;
+}
