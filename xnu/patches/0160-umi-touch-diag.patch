+/*
+ * umi_touch_proto=1: is the acknowledge ours, and is 0xB6 the opcode?
+ *
+ * Two things in a register read are assumptions rather than facts: that 0x49
+ * is this panel (the same overlay carries focaltech@38, so 0x48 has to stay
+ * silent for the acknowledge to mean anything), and that 0xB6 is the byte that
+ * means "hardware register". A slave acknowledges *any* byte sent to its
+ * address, so a wrong opcode is not a failure at the electrical level -- it is
+ * a command the chip does not understand, answered with zeros, which is the
+ * same map a chip with a dark core gives. Sixteen opcodes and a write and
+ * read-back say which of the two this is, and sense-on afterwards asks whether
+ * a core that is running will start scanning.
+ */
+static void
+protocol_scan(void)
+{
+	static const uint8_t opcodes[] = {
+		0xb6, 0xb7, 0xb5, 0xb4, 0xd0, 0xd1, 0xc0, 0xc1,
+		0x80, 0x86, 0x90, 0xa0, 0xb0, 0xe0, 0x5a, 0x4b,
+	};
+	uint8_t data[4];
+	unsigned nonzero = 0;
+	bool present;
+
+	printf("UMI TOUCH: --- is the acknowledge ours? 0x48 has to stay silent ---\n");
+	i2c_ack_reset();
+	i2c_start();
+	present = i2c_write_byte((uint8_t)(0x48 << 1));
+	i2c_stop();
+	printf("UMI TOUCH:   0x48: %s\n", present ? "ACKNOWLEDGES -- so 0x49 means nothing" : "silent");
+	i2c_ack_reset();
+	i2c_start();
+	present = i2c_write_byte((uint8_t)(0x49 << 1));
+	i2c_stop();
+	printf("UMI TOUCH:   0x49: %s\n", present ? "acknowledges" : "SILENT");
+
+	printf("UMI TOUCH: --- the id register through sixteen opcodes ---\n");
+	for (unsigned i = 0; i < sizeof(opcodes); i++) {
+		bool ok;
+
+		memset(data, 0, sizeof(data));
+		ok = fts_read_raw(opcodes[i], FTS_CHIP_ID_ADDR_A, data, sizeof(data));
+		if (!ok) {
+			char mask[ACK_MASK_MAX];
+
+			ack_string(mask, sizeof(mask));
+			printf("UMI TOUCH: op %02x: ack %s, not acknowledged\n", opcodes[i], mask);
+			continue;
+		}
+		for (unsigned b = 0; b < sizeof(data); b++) {
+			if (data[b]) {
+				nonzero++;
+			}
+		}
+		printf("UMI TOUCH: op %02x: %02x %02x %02x %02x\n", opcodes[i],
+		    data[0], data[1], data[2], data[3]);
+	}
+	if (nonzero == 0) {
+		printf("UMI TOUCH: every opcode answered zero, so the opcode is not the problem\n");
+	}
+
+	printf("UMI TOUCH: --- write 0x5a and read it back, sixteen addresses ---\n");
+	for (unsigned address = 0; address < 0x100; address += 0x10) {
+		uint8_t want = 0x5a, back = 0;
+
+		if (!fts_write_registers((uint16_t)address, &want, 1)) {
+			printf("UMI TOUCH: %04x: the write was not acknowledged\n", address);
+			continue;
+		}
+		if (!fts_read_registers((uint16_t)address, &back, 1)) {
+			printf("UMI TOUCH: %04x: written, the read was not acknowledged\n", address);
+			continue;
+		}
+		printf("UMI TOUCH: %04x <- 5a, read back %02x%s\n", address, back,
+		    back == want ? "   <- it stuck" : "");
+	}
+
+	printf("UMI TOUCH: --- sense on, then the id again ---\n");
+	printf("UMI TOUCH: command %02x: %s\n", FTS_CMD_SENSE_ON,
+	    fts_command(FTS_CMD_SENSE_ON) ? "acknowledged" : "not acknowledged");
+	umi_spin_ms(50);
+	for (unsigned i = 0; i < 3; i++) {
+		uint8_t id[2] = { 0, 0 };
+		bool ok = fts_read_registers(FTS_CHIP_ID_ADDR_A, id, sizeof(id));
+
+		printf("UMI TOUCH: id %u: %02x %02x (%s), int %u\n", i, id[0], id[1],
+		    ok ? "acked" : "not acked", gpio_get(PIN_INT));
+	}
+}
