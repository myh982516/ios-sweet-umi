+/*
+ * umi_touch_intmon=1: the interrupt line, before the reset, while it is held,
+ * and for a quarter of a second after it is let go; then a register read at
+ * three clock rates, with the data line read again a millisecond after it.
+ *
+ * gpio39 is the only output of this part that is unambiguously the part's own:
+ * INT low means the chip is driving it, and a chip with no supply or one held
+ * in reset cannot. That separates "answering zeros" from "not answering" in a
+ * way no count of zero bytes can. The line read after the transfer separates
+ * them a second way: if SDA is still low once the master has let go, the chip
+ * owns it and every acknowledge recorded above was this driver's own low level
+ * read back through a line the slave was holding down.
+ */
+static bool
+int_line(void)
+{
+	gpio_configure(PIN_INT, 0, PULL_UP, 2, false);
+	umi_spin_us(200);
+	return gpio_get(PIN_INT);
+}
+
+static void
+int_monitor(void)
+{
+	static const uint32_t rates[] = { 3, 10, 50 };
+	uint32_t saved = bit_us;
+	unsigned edges = 0;
+	bool last;
+
+	printf("UMI TOUCH: --- the interrupt line, through a reset ---\n");
+	printf("UMI TOUCH: int before the reset      %u\n", int_line());
+	gpio_output(PIN_RESET, false, PULL_NONE, 2);
+	umi_spin_ms(5);
+	last = int_line();
+	printf("UMI TOUCH: int with reset held low   %u\n", last);
+	gpio_output(PIN_RESET, true, PULL_NONE, 2);
+	for (unsigned i = 0; i < 250; i++) {
+		bool now = int_line();
+
+		if (now != last) {
+			edges++;
+			printf("UMI TOUCH: int -> %u at %u ms after the reset\n", now, i);
+			last = now;
+		}
+		umi_spin_ms(1);
+	}
+	printf("UMI TOUCH: int after the reset       %u, %u edge(s) in 250 ms%s\n",
+	    last, edges, last ? "" : "   <- the chip is holding it low");
+	for (unsigned i = 0; i < sizeof(rates) / sizeof(rates[0]); i++) {
+		uint8_t id[2] = { 0, 0 };
+		bool ok;
+
+		bit_us = rates[i];
+		i2c_bus_recover();
+		ok = fts_read_registers(FTS_CHIP_ID_ADDR_A, id, sizeof(id));
+		printf("UMI TOUCH: bit_us %2u: id %02x %02x (%s)\n", bit_us, id[0], id[1],
+		    ok ? "acked" : "not acked");
+		line_release(pin_sda);
+		umi_spin_ms(1);
+		printf("UMI TOUCH: sda a millisecond later  %u%s\n", gpio_get(pin_sda),
+		    gpio_get(pin_sda) ? "" : "   <- the chip is holding the line down");
+	}
+	bit_us = saved;
+}
