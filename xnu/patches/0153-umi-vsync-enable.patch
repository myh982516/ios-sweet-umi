--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -274,8 +274,15 @@
 	uint32_t hz = 10;
 	PE_parse_boot_argn("sweetfb_hz", &hz, sizeof(hz));
 	fFlushTicks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
 	fVsync->setTimeoutUS(SWEET_FB_VSYNC_US);
+	/*
+	 * IOTimerEventSource::setTimeout() only arms the timer when the source is
+	 * enabled, and enable() is the only thing that sets that flag: without this
+	 * call the panel timer never fires, so the vsync callbacks (frame pacing,
+	 * the download deadline, the stack sampler) never run.
+	 */
+	fVsync->enable();
 
 	setProperty(kIOUserClientClassKey, "IOMobileFramebufferUserClient");
 	setProperty("external", false);
 	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
