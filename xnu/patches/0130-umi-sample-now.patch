+/*
+ * SWEET: one sampling pass, called from the log thread. The sampler's own
+ * thread sleeps with tsleep(hz * n), which never expires in this port, so the
+ * periodic path never ran; driving it from a thread that does run gets the
+ * samples out.
+ */
+void
+sweet_sample_now(void)
+{
+	static int names_ready;
+	if (!names_ready) {
+		names_ready = 1;
+		if (!PE_parse_boot_argn("sweetsample", sweet_sample_names, sizeof(sweet_sample_names))) {
+			strlcpy(sweet_sample_names, "SpringBoard,backboardd", sizeof(sweet_sample_names));
+		}
+	}
+	if (sweet_sample_names[0] == '-') {
+		return;
+	}
+	proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
+}
