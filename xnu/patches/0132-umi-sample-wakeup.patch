 /* Sampling thread: driven by an absolute deadline, which does work in this
  * port (the tick based sleeps never expire). Samples first and sleeps after,
  * so a dump lands even if the wait never returns. Started from the first exec
  * (kern_exec.c): before that there is no userspace to sample. */
-static int sweet_sample_chan;
-
 static void
 sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 {
-	for (int i = 0; i < 20; i++) {
+	for (int i = 0; i < 200; i++) {
+		if (i != 0) {
+			/* Indefinite sleep woken by the log path: deadline and tick based
