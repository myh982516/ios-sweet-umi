 OSDefineMetaClassAndStructors(IOCoreSurfaceRoot, IOService);
 
+/*
+ * Create and publish the IOSurface root. Nothing else in this kernel does it,
+ * and CoreAnimation asks for IOSurfaceRoot before it ever looks at the display,
+ * so without this the window server gives up early and no framebuffer user
+ * client is ever opened.
+ */
+void
+sweet_surface_start(IOService *provider)
+{
+	IOCoreSurfaceRoot *root;
+
+	if (provider == NULL) {
+		return;
+	}
+	root = OSTypeAlloc(IOCoreSurfaceRoot);
+	if (root == NULL || !root->init() || !root->attach(provider)) {
+		OSSafeReleaseNULL(root);
+		IOLog("SWEET SURF: cannot create the root service\n");
+		return;
+	}
+	if (!root->start(provider)) {
+		root->detach(provider);
+		IOLog("SWEET SURF: the root service did not start\n");
+	} else {
+		IOLog("SWEET SURF: IOSurfaceRoot published\n");
+	}
+	root->release();
+}
+
 bool
 IOCoreSurfaceRoot::start(IOService *provider)
 {
 	printf("SWEET SURF: IOCoreSurfaceRoot::start entered\n");
 	if (!IOService::start(provider)) {
 		return false;
 	}
+	IOLog("SWEET SURF: root start entered\n");
 	sweet_surface_init_lock();
 	setProperty(kIOUserClientClassKey, "IOSurfaceRootUserClient");
 	registerService();
 	IOLog("SWEET SURF: IOCoreSurfaceRoot registered\n");
