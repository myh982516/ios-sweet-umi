+/*
+ * Called from panic(). Write the ring once, without taking locks and without
+ * printing: a panic may happen with the console lock or the block lock held, and
+ * the ring is the only place the reason for the panic is still recorded.
+ */
+void
+sweet_log_panic_flush(void)
+{
+	if (!su.ready || !su.writable || su.nblocks <= SWEET_LOG_BLOCKS) {
+		return;
+	}
+	sweet_in_panic = 1;
+	sweet_log_flush_to_disk();
+}
