+/*
+ * SWEET heartbeat on the panel itself: the persistent log needs UFS writes,
+ * and those are exactly what we suspect of hanging the boot. Drawing a bar
+ * needs nothing but a mapped framebuffer, so a photo of the screen tells how
+ * many ticks the kernel survived. The text console keeps drawing (it prints a
+ * SWEET TICK line every period); muting it made a live system look frozen, so
+ * it is only muted when the sweetfbmute boot argument asks for it.
+ */
+static volatile uint32_t *sweet_hb_fb;
+static uint32_t sweet_hb_row, sweet_hb_w, sweet_hb_h;
+static int sweet_hb_mute;
+static int sweet_hb_mute_parsed;
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* osfmk/console/serial_console.c: non-zero stops drawing text on the panel
+ * (the ring log still gets every byte). */
+extern int sweet_console_muted;
+
+static void
+sweet_hb_map(void)
+{
+	PE_Video video;
+
+	if (!sweet_hb_mute_parsed) {
+		sweet_hb_mute_parsed = 1;
+		PE_parse_boot_argn("sweetfbmute", &sweet_hb_mute, sizeof(sweet_hb_mute));
+	}
+	if (sweet_hb_fb != NULL) {
+		return;
+	}
+	PE_current_console(&video);
+	if (video.v_baseAddr == 0 || video.v_rowBytes == 0 || video.v_height == 0) {
+		return;
+	}
+	/*
+	 * Map only the rows the bar lives in. Mapping the whole panel needs about
+	 * 10 MB of kernel map and the kernel then fails a later kmem_alloc
+	 * (observed: panic in vm_kern.c at the first exec), so keep it tiny.
+	 */
+	vm_size_t size = (vm_size_t)video.v_rowBytes * 16;
+	vm_offset_t va = ml_io_map((vm_offset_t)video.v_baseAddr, size);
+	if (va == 0) {
+		return;
+	}
+	sweet_hb_w = (uint32_t)video.v_width;
+	sweet_hb_h = (uint32_t)video.v_height;
+	sweet_hb_row = (uint32_t)video.v_rowBytes / 4;
+	sweet_hb_fb = (volatile uint32_t *)va;
+	if (sweet_hb_mute) {
+		sweet_console_muted = 1;
+	}
+	/* Opaque white corner marker: proof that the mapping and the format work,
+	 * independent of the bar. */
+	for (uint32_t y = 0; y < 24; y++) {
+		for (uint32_t x = 0; x < 24; x++) {
+			sweet_hb_fb[y * sweet_hb_row + x] = 0xffffffffu;
+		}
+	}
+}
+
+/* n filled blocks out of 64 to the right of the marker (a8r8g8b8, opaque). */
+extern "C" void
+sweet_fb_heartbeat(int n)
+{
+	sweet_hb_map();
+	if (sweet_hb_fb == NULL) {
+		return;
+	}
+	if (n < 0) {
+		n = 0;
+	}
+	if (n > 64) {
+		n = 64;
+	}
+	for (int i = 0; i < 64; i++) {
+		uint32_t color = (i < n) ? 0xff00ff00u : 0xff000000u;
+		for (uint32_t y = 0; y < 12; y++) {
+			for (uint32_t x = 0; x < 12; x++) {
+				uint32_t px = 32 + (uint32_t)i * 12 + x;
+				if (px < sweet_hb_w) {
+					sweet_hb_fb[y * sweet_hb_row + px] = color;
+				}
+			}
+		}
+	}
+}
+
 class AppleCLCD : public IOMobileFramebuffer {
 	OSDeclareDefaultStructors(AppleCLCD);
 
